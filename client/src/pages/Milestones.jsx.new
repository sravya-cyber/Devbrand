import { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import api from "../services/api";
import toast from "react-hot-toast";
import { Trophy, CheckCircle, X, Send, RefreshCw, Star, Code, Github, Filter, Zap } from "lucide-react";

const PLATFORM_CONFIG = {
  codeforces: { icon: Trophy,  color: "#f59e0b", bg: "rgba(245,158,11,0.1)",  label: "Codeforces" },
  leetcode:   { icon: Code,    color: "#f97316", bg: "rgba(249,115,22,0.1)",  label: "LeetCode" },
  github:     { icon: Github,  color: "#a5a0ff", bg: "rgba(165,160,255,0.1)", label: "GitHub" },
};

const STATUS_FILTERS = [
  { key: "all",           label: "All" },
  { key: "pending",       label: "Pending" },
  { key: "post_drafted",  label: "Drafted" },
  { key: "post_published",label: "Published" },
  { key: "dismissed",     label: "Dismissed" },
];

export default function Milestones() {
  const navigate = useNavigate();
  const [milestones, setMilestones] = useState([]);
  const [loading, setLoading]       = useState(true);
  const [filter, setFilter]         = useState("all");
  const [expanded, setExpanded]     = useState(null);
  const [scheduling, setScheduling] = useState({});
  const [dismissing, setDismissing] = useState({});
  const [scheduleTime, setScheduleTime] = useState({});

  const fetch = async () => {
    setLoading(true);
    try {
      const params = filter !== "all" ? { status: filter } : {};
      const { data } = await api.get("/milestones", { params });
      setMilestones(data.milestones);
    } catch { toast.error("Failed to load milestones"); }
    finally { setLoading(false); }
  };

  useEffect(() => { fetch(); }, [filter]);

  const handleSchedule = async (m) => {
    const time = scheduleTime[m._id];
    if (!time) return toast.error("Pick a schedule time first");
    setScheduling(s => ({ ...s, [m._id]: true }));
    try {
      await api.post("/posts", {
        content: m.draftedContent,
        platforms: ["linkedin"],
        scheduledAt: time,
        aiGenerated: true,
        aiSource: m.platform,
        milestoneId: m._id,
      });
      await api.patch(`/milestones/${m._id}/dismiss`);
      toast.success("Post scheduled! 🎉");
      fetch();
      navigate("/calendar");
    } catch (err) { toast.error(err.response?.data?.message || "Failed"); }
    finally { setScheduling(s => ({ ...s, [m._id]: false })); }
  };

  const handleDismiss = async (id) => {
    setDismissing(s => ({ ...s, [id]: true }));
    try { await api.patch(`/milestones/${id}/dismiss`); toast.success("Dismissed"); fetch(); }
    catch { toast.error("Failed to dismiss"); }
    finally { setDismissing(s => ({ ...s, [id]: false })); }
  };

  const pendingCount = milestones.filter(m => m.status === "pending").length;
  const minDateTime  = new Date(Date.now() + 2 * 60 * 1000).toISOString().slice(0, 16);

  return (
    <div style={{ padding: "32px 36px", width: "100%" }}>

      {/* ── Header ── */}
      <div style={{ marginBottom: 28 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6 }}>
          <h1 style={{ fontSize: 26, fontWeight: 700, color: "#0f172a", letterSpacing: "-0.03em" }}>
            Milestones
          </h1>
          {pendingCount > 0 && (
            <span style={{
              background: "rgba(167,139,250,0.12)",
              color: "#7c3aed",
              fontSize: 11,
              fontWeight: 700,
              padding: "3px 9px",
              borderRadius: 99,
              border: "1px solid rgba(167,139,250,0.2)",
              fontFamily: "JetBrains Mono",
            }}>{pendingCount} pending</span>
          )}
        </div>
        <p style={{ color: "#475569", fontSize: 14 }}>
          Achievements auto-detected from your coding activity
        </p>
      </div>

      {/* ── Filter tabs ── */}
      <div style={{
        display: "flex",
        gap: 4,
        marginBottom: 24,
        background: "rgba(241,245,249,0.9)",
        padding: 4,
        borderRadius: 12,
        width: "fit-content",
        border: "1px solid rgba(148,163,184,0.12)",
      }}>
        {STATUS_FILTERS.map(({ key, label }) => (
          <button key={key} onClick={() => setFilter(key)} style={{
            padding: "6px 14px",
            borderRadius: 9,
            border: "none",
            cursor: "pointer",
            fontSize: 13,
            fontWeight: 500,
            fontFamily: "Space Grotesk",
            transition: "all 0.15s",
            background: filter === key ? "rgba(167,139,250,0.18)" : "transparent",
            color: filter === key ? "#5b21b6" : "#475569",
          }}>{label}</button>
        ))}
      </div>

      {/* ── Content ── */}
      {loading ? (
        <div style={{ display: "flex", justifyContent: "center", padding: "80px 0" }}>
          <div style={{
            width: 32,
            height: 32,
            border: "2px solid #7c3aed",
            borderTopColor: "transparent",
            borderRadius: "50%",
            animation: "spin 0.7s linear infinite",
          }} />
        </div>
      ) : milestones.length === 0 ? (
        <div className="card" style={{
          textAlign: "center",
          padding: "60px 32px",
          background: "rgba(255,255,255,0.96)",
          border: "1px solid rgba(148,163,184,0.12)",
          borderRadius: 18,
        }}>
          <Trophy size={44} color="#4338ca" style={{ margin: "0 auto 12px" }} />
          <p style={{ color: "#334155", fontWeight: 600, fontSize: 16, marginBottom: 6 }}>No milestones yet</p>
          <p style={{ color: "#64748b", fontSize: 13, lineHeight: 1.7 }}>
            Connect your Codeforces, LeetCode, or GitHub profile.<br />
            We'll detect achievements automatically every 2 hours.
          </p>
        </div>
      ) : (
        <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
          {milestones.map((m, i) => {
            const cfg = PLATFORM_CONFIG[m.platform] || { icon: Star, color: "#6c63ff", bg: "rgba(108,99,255,0.1)", label: m.platform };
            const Icon = cfg.icon;
            const isExpanded = expanded === m._id;
            const isPending  = m.status === "pending";
            const isPublished = m.status === "post_published";

            return (
              <div key={m._id} className="animate-fade-up" style={{
                animationDelay: `${i * 40}ms`,
                background: "rgba(255,255,255,0.96)",
                border: `1px solid rgba(148,163,184,0.12)`,
                borderRadius: 16,
                padding: "18px 20px",
                color: "#0f172a",
                opacity: m.status === "dismissed" ? 0.55 : 1,
                transition: "border-color 0.2s",
              }}>
                {/* Top row */}
                <div style={{ display: "flex", alignItems: "flex-start", gap: 14 }}>
                  {/* Platform icon */}
                  <div style={{
                    width: 38,
                    height: 38,
                    borderRadius: 10,
                    flexShrink: 0,
                    background: cfg.bg,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                  }}>
                    <Icon size={18} color={cfg.color} />
                  </div>

                  {/* Text */}
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: 8 }}>
                      <p style={{ fontWeight: 600, fontSize: 15, color: "#0f172a", letterSpacing: "-0.01em" }}>
                        {m.title}
                      </p>
                      <span style={{
                        fontSize: 10,
                        fontWeight: 700,
                        padding: "3px 8px",
                        borderRadius: 99,
                        fontFamily: "JetBrains Mono",
                        flexShrink: 0,
                        letterSpacing: "0.05em",
                        background: isPending ? "rgba(245,158,11,0.12)" : isPublished ? "rgba(34,197,94,0.12)" : "rgba(226,232,240,0.8)",
                        color: isPending ? "#b45309" : isPublished ? "#15803d" : "#475569",
                        border: `1px solid ${isPending ? "rgba(245,158,11,0.2)" : isPublished ? "rgba(34,197,94,0.2)" : "rgba(148,163,184,0.12)"}`,
                      }}>{m.status.replace("_", " ").toUpperCase()}</span>
                    </div>
                    <p style={{ fontSize: 12, color: "#64748b", marginTop: 3 }}>
                      <span style={{ color: cfg.color, fontWeight: 500 }}>{cfg.label}</span>
                      {" · "}
                      {new Date(m.detectedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                    </p>
                  </div>
                </div>

                {/* Actions for pending */}
                {isPending && (
                  <div style={{ marginTop: 16, paddingTop: 14, borderTop: "1px solid rgba(148,163,184,0.12)" }}>
                    <button onClick={() => setExpanded(isExpanded ? null : m._id)} style={{
                      fontSize: 12,
                      color: "#5b21b6",
                      background: "none",
                      border: "none",
                      cursor: "pointer",
                      fontFamily: "Space Grotesk",
                      fontWeight: 500,
                      padding: 0,
                      marginBottom: isExpanded ? 12 : 14,
                    }}>
                      {isExpanded ? "▲ Hide AI draft" : "▼ View AI draft post"}
                    </button>

                    {isExpanded && (
                      <div style={{
                        background: "rgba(247,245,255,0.92)",
                        border: "1px solid rgba(167,139,250,0.3)",
                        borderRadius: 12,
                        padding: "14px 16px",
                        marginBottom: 14,
                      }}>
                        <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 8 }}>
                          <Zap size={11} color="#7c3aed" />
                          <span style={{
                            fontSize: 10,
                            fontWeight: 700,
                            color: "#7c3aed",
                            letterSpacing: "0.08em",
                            fontFamily: "JetBrains Mono",
                          }}>AI DRAFT</span>
                        </div>
                        <p style={{ fontSize: 13, color: "#334155", lineHeight: 1.75, whiteSpace: "pre-wrap" }}>
                          {m.draftedContent || "No draft available"}
                        </p>
                      </div>
                    )}

                    <div style={{ display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
                      <input type="datetime-local" min={minDateTime}
                        className="input"
                        style={{
                          flex: 1,
                          minWidth: 180,
                          fontSize: 13,
                          background: "rgba(248,250,252,0.95)",
                          border: "1px solid rgba(148,163,184,0.12)",
                          color: "#0f172a",
                          borderRadius: 10,
                          padding: "10px 12px",
                        }}
                        value={scheduleTime[m._id] || ""}
                        onChange={e => setScheduleTime(s => ({ ...s, [m._id]: e.target.value }))}
                      />
                      <button onClick={() => handleSchedule(m)}
                        disabled={scheduling[m._id] || !scheduleTime[m._id]}
                        className="btn-primary"
                        style={{
                          flexShrink: 0,
                          fontSize: 13,
                          background: "#7c3aed",
                          color: "#ffffff",
                          border: "1px solid rgba(124,58,237,0.25)",
                          borderRadius: 10,
                          padding: "10px 14px",
                        }}>
                        {scheduling[m._id]
                          ? <><RefreshCw size={13} style={{ animation: "spin 0.7s linear infinite" }} /> Scheduling...</>
                          : <><Send size={13} /> Schedule Post</>}
                      </button>
                      <button onClick={() => handleDismiss(m._id)} disabled={dismissing[m._id]}
                        className="btn-secondary"
                        style={{
                          flexShrink: 0,
                          fontSize: 13,
                          background: "rgba(241,245,249,0.95)",
                          color: "#334155",
                          border: "1px solid rgba(148,163,184,0.12)",
                          borderRadius: 10,
                          padding: "10px 14px",
                        }}>
                        <X size={13} /> Dismiss
                      </button>
                    </div>
                  </div>
                )}

                {/* Published indicator */}
                {isPublished && (
                  <div style={{
                    marginTop: 12,
                    paddingTop: 12,
                    borderTop: "1px solid rgba(148,163,184,0.12)",
                    display: "flex",
                    alignItems: "center",
                    gap: 6,
                  }}>
                    <CheckCircle size={13} color="#15803d" />
                    <span style={{ fontSize: 12, color: "#15803d", fontWeight: 500 }}>Post published successfully</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
    </div>
  );
}
