# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (Free M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devbrand?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Upstash Redis (Free Tier)
REDIS_URL=redis://default:<password>@<host>.upstash.io:<port>

# Google Gemini API (Free)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (Free image generation)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Twitter API v2 (Free Developer Account)
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_CALLBACK_URL=http://localhost:5000/api/accounts/twitter/callback

# LinkedIn API (Free Developer Account)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/accounts/linkedin/callback

# Client URL
CLIENT_URL=http://localhost:5173

# Encryption key for storing tokens
ENCRYPTION_KEY=your_32_char_encryption_key_here
